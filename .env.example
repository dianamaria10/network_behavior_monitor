# Optional runtime configuration
NBM_DB_PATH=data/traffic_monitor.db
NBM_MODEL_PATH=models/isolation_forest.pkl
NBM_WINDOW_SECONDS=10
NBM_ANALYZER_INTERVAL_SECONDS=10
NBM_SCAPY_FILTER=ip
# NBM_INTERFACE=eth0

# Optional Telegram notifications
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=123456789

# Rule thresholds
NBM_MIN_PACKETS_FOR_RULE=20
NBM_MAX_PACKETS_PER_SECOND=80
NBM_MAX_BYTES_PER_SECOND=500000
NBM_MAX_UNIQUE_DST_PORTS=15
NBM_MAX_SYN_RATIO=0.60
NBM_MAX_ICMP_RATIO=0.80
NBM_MAX_UNIQUE_DST_IPS=20
